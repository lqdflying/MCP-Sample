# ── MCP server authentication ────────────────────────────────────────────────
#
# Auth mode:
# - token: static token only (MCP_API_TOKEN required)
# - oauth: GitHub OAuth only (MCP_API_TOKEN ignored)
# - both:  token + GitHub OAuth (MCP_API_TOKEN required)
MCP_AUTH_MODE=both

# Auth audit log switch:
# - true:  log auth decisions (method, oauth login, allowlist result); never logs token values
# - false: disable auth audit logs
MCP_AUTH_AUDIT_LOG=true

# Static MCP API Token — required when MCP_AUTH_MODE is `token` or `both`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=your_secret_mcp_token_here

# ── GitHub OAuth (required when MCP_AUTH_MODE is `oauth` or `both`) ──────────
#
# Register a GitHub OAuth App and paste its credentials here.
# All three of CLIENT_ID, CLIENT_SECRET, and BASE_URL must be set together.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL for this MCP server (used for OAuth callbacks/metadata),
# e.g. https://mcp.example.com
BASE_URL=

# OAuth scopes (comma-separated). Keep least privilege when possible.
# Default when omitted: read:user
GITHUB_OAUTH_SCOPES=read:user

# Comma-separated GitHub logins allowed to sign in via OAuth, e.g. your-username
# Leave empty to allow any valid GitHub account (open to all users).
# Set this to your own login to restrict OAuth sign-in to your account only.
ALLOWED_GITHUB_LOGINS=

# OAuth storage location. Set to a writable directory for persistent encrypted
# storage of OAuth client registrations and refresh-token mappings. Leave empty
# to use in-memory storage (recommended for containers / serverless).
FASTMCP_HOME=

# ── Transport ────────────────────────────────────────────────────────────────
#
# - true (default): stateless — new transport per request, survives restarts.
# - false: stateful — keep session state in memory across requests.
MCP_STATELESS=true

# ── Server bind ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
