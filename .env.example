# ── MCP server authentication ────────────────────────────────────────────────
#
# Auth mode:
# - token: static token only (MCP_API_TOKEN required)
# - oauth: GitHub OAuth only (MCP_API_TOKEN ignored)
# - both:  token + GitHub OAuth (MCP_API_TOKEN required)
MCP_AUTH_MODE=both

# Auth audit log switch:
# - true:  log auth decisions (method, oauth login, allowlist result); never logs token values
# - false: disable auth audit logs
MCP_AUTH_AUDIT_LOG=true

# Static MCP API Token — required when MCP_AUTH_MODE is `token` or `both`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=your_secret_mcp_token_here

# ── GitHub OAuth (required when MCP_AUTH_MODE is `oauth` or `both`) ──────────
#
# Register a GitHub OAuth App and paste its credentials here.
# All three of CLIENT_ID, CLIENT_SECRET, and BASE_URL must be set together.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL for this MCP server (used for OAuth callbacks/metadata),
# e.g. https://mcp.example.com
BASE_URL=

# OAuth scopes (comma-separated). Keep least privilege when possible.
# Default when omitted: read:user
GITHUB_OAUTH_SCOPES=read:user

# Comma-separated GitHub logins allowed to sign in via OAuth, e.g. your-username
# Leave empty to allow any valid GitHub account (open to all users).
# Set this to your own login to restrict OAuth sign-in to your account only.
ALLOWED_GITHUB_LOGINS=

# OAuth storage location. Set to a writable directory for persistent encrypted
# storage of OAuth client registrations and refresh-token mappings.
# When unset, FastMCP uses its default storage location.
FASTMCP_HOME=

# ── FastMCP (optional) ──────────────────────────────────────────────────────
# FASTMCP_SHOW_SERVER_BANNER=false
# FASTMCP_ENABLE_RICH_LOGGING=false

# ── Transport ────────────────────────────────────────────────────────────────
#
# - true (default): stateless — new transport per request, survives restarts.
# - false: stateful — keep session state in memory across requests.
MCP_STATELESS=true

# ── Policy Database (enables Full mode: RBAC, per-user tokens, MFA) ──────────
#
# When MCP_POLICY_DB_HOST is set, the server runs in "full mode" with:
# - Per-user API tokens (replaces static MCP_API_TOKEN for multi-user setups)
# - 3-tier RBAC: admin, useradmin, user
# - MFA (TOTP + backup codes) for admin UI
# - Token auto-rotation with email notifications
# - Audit logging
#
# When unset, the server runs in "lightweight mode" (static token only).
MCP_POLICY_DB_HOST=
MCP_POLICY_DB_PORT=3306
MCP_POLICY_DB_USER=mcp
MCP_POLICY_DB_PASSWORD=
MCP_POLICY_DB_NAME=mcp_policy

# Encryption key for MFA secrets and OAuth KV store (Fernet, base64-encoded).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=

# Seed the first admin user on empty database startup (GitHub login).
MCP_ADMIN_SEED=

# ── Token Auto-Rotation ──────────────────────────────────────────────────────
# Rotate tokens that expire within this many days
MCP_TOKEN_ROTATE_LEAD_DAYS=7
# How often to check for tokens needing rotation (seconds)
MCP_TOKEN_ROTATE_POLL_SEC=3600

# ── SMTP (email notifications for token rotation) ────────────────────────────
MCP_SMTP_HOST=
MCP_SMTP_PORT=587
MCP_SMTP_USER=
MCP_SMTP_PASSWORD=
MCP_SMTP_FROM=noreply@example.com
MCP_SMTP_FROM_NAME=MCP Server
MCP_SMTP_USE_TLS=true

# ── Server bind ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Debug / Structured Logging ───────────────────────────────────────────────
#
# MCP_DEBUG=true enables structured debug events (tool calls, auth decisions)
# via src/debug.py debug_log(). All logs are JSONL regardless of this setting.
MCP_DEBUG=false

# MCP_DEBUG_VERBOSE=true disables field redaction in debug events.
# WARNING: exposes full tool arguments and error messages. Dev/staging only.
MCP_DEBUG_VERBOSE=false
